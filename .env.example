# ------------------------------------------------------------------
# خصص بقالتك — إعداد البيئة المحلية
# انسخ هذا الملف إلى ‎.env قبل أول تشغيل:  cp .env.example .env
# ------------------------------------------------------------------

# قاعدة بيانات SQLite (المسار نسبي إلى مجلد prisma/)
DATABASE_URL=file:../db/custom.db

# Required for public deployments to access /api/admin/* (use a long random secret).
# ADMIN_API_KEY=replace-with-a-long-random-secret

# Trust X-Forwarded-For / X-Real-IP for per-client rate limiting. Enable ONLY behind a
# reverse proxy that OVERWRITES (never appends to) those headers — e.g. the bundled
# Caddyfile. Leave disabled when the app is exposed directly.
# TRUST_PROXY_HEADERS=true

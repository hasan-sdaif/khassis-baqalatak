# قاعدة بيانات SQLite (المسار نسبي إلى مجلد prisma/)
DATABASE_URL=file:../db/custom.db

# Required for public deployments to access /api/admin/* (use a long random secret).
# ADMIN_API_KEY=replace-with-a-long-random-secret
